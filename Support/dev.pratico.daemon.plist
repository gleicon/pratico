<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Registered by Pratico.app via SMAppService.agent(plistName:) (SPEC D-13). -->
	<key>Label</key>
	<string>dev.pratico.daemon</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/pratico-daemon</string>
	<!-- Starts on register and at login. No KeepAlive: a crashed daemon stays
	     stopped and the menubar shows it (SPEC AC-35). -->
	<key>RunAtLoad</key>
	<true/>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>dev.pratico.menubar</string>
	</array>
</dict>
</plist>
