<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Registered by Pratico.app via SMAppService.daemon(plistName:) when the user turns
	     on "Use /var/run/docker.sock". Runs as root, at boot too: macOS empties /var/run. -->
	<key>Label</key>
	<string>dev.pratico.socket</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/pratico-socket-link</string>
	<key>RunAtLoad</key>
	<true/>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>dev.pratico.menubar</string>
	</array>
</dict>
</plist>
